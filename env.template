# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Checkout sends a Square Order (merchandise line items). Buyers enter contact + shipping on Square.
# Dashboard shipping profiles for Square Online often do NOT apply to Payment Links built via the API;
# to show a shipping charge here, set one flat amount (matches your typical rate / policy):
#   SQUARE_CHECKOUT_SHIPPING_CENTS=1299
# or
#   SQUARE_CHECKOUT_SHIPPING_USD=12.99
# Optional label on the receipt: SQUARE_CHECKOUT_SHIPPING_LABEL=Shipping
#
# --- Sales tax (use ONE approach; do not enable both or Square may double-apply) ---
#
# Option A — Square applies taxes (catalog / rules; buyer-location depends on Square Tax setup):
#   SQUARE_CHECKOUT_AUTO_APPLY_TAXES=true
# Requires taxes in Square Catalog (CatalogTax) that apply to your line items. For bundle/ad hoc
# lines (name + base_price_money), create a CatalogTax with applies_to_custom_amounts: true.
# See: https://developer.squareup.com/docs/orders-api/apply-taxes-and-discounts/auto-apply-taxes
# Verify NY vs TN (etc.) on a real Payment Link; if rates stay fixed, ask Square Support whether
# API Payment Links use your Tax enrolment for destination-based calculation.
#
# Option B — Your app sends one flat % on the order (same rate for every checkout):
#   SQUARE_CHECKOUT_TAX_PERCENT=9.75
#   SQUARE_CHECKOUT_TAX_NAME=Sales Tax - Hardin County (TN)   # optional
# (Confirm nexus and rates with your tax adviser.)
#
# If the shipping address field keeps reverting while you edit, that is Square’s checkout UI
# (autocomplete / verified suggestions / saved buyer). This app does not send buyer_address.
# Use “Enter address manually” or try a private window; contact Square Support if it persists.
#
# Optional: squareVariationIds in data/store.json for catalog-linked Square lines.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
