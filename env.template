# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhooks: Square subscription URL must match exactly, e.g. https://your-domain/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Signature key from the sandbox webhook subscription only (Square requires a different URL per env).
SQUARE_WEBHOOK_SIGNATURE_KEY_SANDBOX=

# --- On-site checkout (Square Web Payments SDK) — default when this is set ---
SQUARE_APPLICATION_ID=

# --- Embedded checkout shipping (Shippo validates address; flat base + optional residential surcharge) ---
# https://goshippo.com — server-side token only.
SHIPPO_API_TOKEN=
SHIPPO_API_BASE_URL=https://api.goshippo.com
# Flat amounts (USD). Default base 0 = shipping line shows "Free" when cost is baked into catalog prices.
CHECKOUT_BASE_SHIPPING_USD=0
CHECKOUT_RESIDENTIAL_SURCHARGE_USD=6.50

# --- Sales tax (TN nexus only) ---
# 975 = 9.75% on taxable base (merchandise + shipping when CHECKOUT_TAX_INCLUDES_SHIPPING is true).
SALES_TAX_TN_BPS=975
# true = TN tax applies to merchandise + shipping; false = merchandise only
CHECKOUT_TAX_INCLUDES_SHIPPING=true

# --- Hardin County TN promo (one-time codes in sql/discount_codes.sql) ---
# If a bundle has no hardinPriceCents in data/store.json, Hardin tier uses priceCents * this (default 0.93).
HARDIN_PRICE_MULTIPLIER=0.93
# Optional: override allowed 5-digit ZIPs (comma/space-separated). Defaults to Hardin County list in lib/hardin-county.js.
# HARDIN_COUNTY_ZIPS=38372,38326,38361,38365,38370,38375,38379

# --- Staff manual orders (/admin/manual-order): Square payment links + Resend email ---
# Requires PUBLIC_BASE_URL (redirect after Square checkout). Run sql/patch-manual-orders.sql in Supabase
# (manual columns, admin_local_discount_override, updated_at). Optional: sql/patch-admin-local-discount-override.sql if you split patches.
# RESEND_API_KEY + RESEND_FROM must be set for “Send payment link” to email the customer.

# --- Internal reports (GET /api/nexus-summary, GET /api/tax-summary, GET /api/admin-discount-codes) ---
# If set, allow either Authorization: Bearer <INTERNAL_REPORTS_SECRET> (scripts) or
# Authorization: Bearer <Supabase access JWT> after staff sign-in on /admin/*.
# Leave unset for local dev only (open endpoints — do not use unset in production).
INTERNAL_REPORTS_SECRET=

# Set to "off" to skip Shippo remote validation (local ZIP/format checks still apply).
ADDRESS_VALIDATION=

# --- Legacy: Square Payment Link (hosted checkout.square.site) ---
# Used only when SQUARE_APPLICATION_ID is NOT set but other Square + Supabase vars are.
#   SQUARE_CHECKOUT_SHIPPING_CENTS=1299
#   SQUARE_CHECKOUT_AUTO_APPLY_TAXES / SQUARE_CHECKOUT_TAX_PERCENT (see Square docs)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key (safe in browser). Used by /admin/orders — access is limited by RLS to signed-in users.
# Create staff users in Supabase → Authentication → Users. Set Site URL + Redirect URLs to include /admin/orders.html
SUPABASE_ANON_KEY=

# --- Order confirmation email (Resend) — https://resend.com
# After successful on-site checkout, sends HTML confirmation. Verified sending domain required.
RESEND_API_KEY=
# Must be email@domain.com OR Display Name <email@domain.com> (domain verified in Resend / DNS e.g. Bluehost).
# Examples: RESEND_FROM=sales@saigoods.com
#           RESEND_FROM=SAI Goods <sales@saigoods.com>
RESEND_FROM=

# Optional: squareVariationIds in data/store.json for catalog-linked Square lines.
