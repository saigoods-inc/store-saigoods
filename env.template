# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Checkout sends a Square Order (line items) plus shipping_fee from your server (UPS zone tables + cart ZIP).
# Local free shipping (25 mi from warehouse by default): set WAREHOUSE_LATITUDE / WAREHOUSE_LONGITUDE, or list ZIPs:
#   FREE_SHIPPING_ZIPS=38372,38326
# (Recommended on Vercel — OSM Nominatim may block server IPs; the ZIP list always works.)
# Optional: FREE_SHIPPING_RADIUS_MILES=25, NOMINATIM_USER_AGENT (identify your site per OSM policy).
# Optional: squareVariationIds in data/store.json for Square catalog-linked lines.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
