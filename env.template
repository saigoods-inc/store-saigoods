# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhooks: Square subscription URL must match exactly, e.g. https://your-domain/api/webhooks/square
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Signature key from the sandbox webhook subscription only (Square requires a different URL per env).
SQUARE_WEBHOOK_SIGNATURE_KEY_SANDBOX=

# --- On-site checkout (Square Web Payments SDK) — default when this is set ---
SQUARE_APPLICATION_ID=

# --- Embedded checkout shipping (Shippo validates address; residential surcharge when applicable) ---
# https://goshippo.com — server-side token only.
SHIPPO_API_TOKEN=
SHIPPO_API_BASE_URL=https://api.goshippo.com
# Optional: receiver-facing webhook auth token. If set, Shippo webhook URL must include ?token=<value>.
SHIPPO_WEBHOOK_TOKEN=
# Required in production/Vercel. Configure Shippo webhook URL with ?token=<value> or X-Shippo-Webhook-Token header.
# INSECURE local-only escape hatch (ignored when NODE_ENV=production or VERCEL=1):
# ALLOW_INSECURE_LOCAL_SHIPPO_WEBHOOK=true
# Shippo /shipments/ and rate quotes: set address_to.is_residential so carrier rates include residential delivery. false = omit (not recommended).
# SHIPPO_ADDRESS_TO_IS_RESIDENTIAL=true
# Optional sender defaults for creating Shippo Orders (recommended for dashboard readiness).
SHIPPO_FROM_NAME=
SHIPPO_FROM_COMPANY=
SHIPPO_FROM_EMAIL=
SHIPPO_FROM_PHONE=
# Must match the physical origin — rates use this. No code default street.
SHIPPO_FROM_STREET1=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
# Optional second line for warehouse ship-from display (same as Shippo street2 when used).
SHIPPO_FROM_STREET2=
# Optional: Shippo carrier account object_ids (comma list). Same as Shippo shipment for labels.
# SHIPPO_UPS_CARRIER_ACCOUNT_ID=
# SHIPPO_CARRIER_ACCOUNT_IDS=
# Checkout: POST /shipments/ for rates when SHIPPING_QUOTE_MODE=live_ups and SHIPPING_RATE_PROVIDER=shippo
SHIPPO_RATE_TIMEOUT_MS=20000
# Added to the live Shippo/UPS line at quote time (not part of the stored provider rate or providerQuoteId). Example: 200 = $2.00
SHIPPING_BUFFER_CENTS=200
# Server log only: 1 = log raw estimate address, normalized address, parcel plan, and exact Shippo POST /shipments/ from/to/parcels + selected rate
# CHECKOUT_ESTIMATE_SHIPPO_LOG=1
# Live rating backend: shippo | ups (default ups if unset, for backward compatibility in existing deploys)
SHIPPING_RATE_PROVIDER=shippo
# baked_in = legacy catalog-included shipping; live_ups = live provider (default if unset; Shippo or UPS per SHIPPING_RATE_PROVIDER)
# SHIPPING_QUOTE_MODE=baked_in
# Fallback line-item weight used when order items do not carry explicit weights.
SHIPPO_DEFAULT_ITEM_WEIGHT_LB=1
# --- UPS live rating (Phase 2A core modules; server-side only) ---
# OAuth client credentials from UPS developer app.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Base URL defaults to UPS sandbox (wwwcie). Set production API base when going live.
# UPS_API_BASE_URL=https://wwwcie.ups.com
# Optional override for OAuth host when it differs from API host.
# UPS_OAUTH_BASE_URL=https://wwwcie.ups.com
# Optional override for rating endpoint version/path.
# UPS_RATE_ENDPOINT_PATH=/api/rating/v2403/Shop
# Optional per-call timeouts (ms).
UPS_AUTH_TIMEOUT_MS=15000
UPS_RATE_TIMEOUT_MS=20000
# Billing account used by UPS rating payload.
UPS_ACCOUNT_NUMBER=
# Ship-from used for rating. Falls back to SHIPPO_FROM_* where possible.
UPS_SHIPPER_NAME=
UPS_SHIP_FROM_STREET1=
UPS_SHIP_FROM_STREET2=
UPS_SHIP_FROM_CITY=
UPS_SHIP_FROM_STATE=
UPS_SHIP_FROM_POSTAL_CODE=
UPS_SHIP_FROM_COUNTRY_CODE=US
# Optional harness overrides for scripts/test-ups-rates.mjs
# UPS_TEST_TO_LINE1=
# UPS_TEST_TO_LINE2=
# UPS_TEST_TO_CITY=
# UPS_TEST_TO_STATE=
# UPS_TEST_TO_POSTAL_CODE=
# UPS_TEST_TO_COUNTRY=US
# UPS_TEST_PARCEL_LENGTH=12
# UPS_TEST_PARCEL_WIDTH=8
# UPS_TEST_PARCEL_HEIGHT=6
# UPS_TEST_PARCEL_DISTANCE_UNIT=in
# UPS_TEST_PARCEL_WEIGHT=5
# UPS_TEST_PARCEL_MASS_UNIT=lb
# When true, checkout + Square webhook auto-create/sync Shippo orders after payment. Default: off (staff fulfill externally).
# ENABLE_SHIPPO_ORDER_SYNC=true
# Private bucket for admin-uploaded shipping labels & packing slips (see sql/patch-orders-manual-external-fulfillment.sql).
# SUPABASE_ORDER_DOCS_BUCKET=order-fulfillment-docs
# Catalog prices include shipping (checkout always shows Shipping: Free). USD fee when Shippo marks residential.
CHECKOUT_RESIDENTIAL_SURCHARGE_USD=6.50

# --- Sales tax (TN nexus only) ---
# 975 = 9.75% on merchandise subtotal + residential surcharge (when charged). Catalog shipping is in merchandise.
SALES_TAX_TN_BPS=975

# --- Hardin County TN promo (one-time codes in sql/discount_codes.sql) ---
# If a bundle has no hardinPriceCents in data/store.json, Hardin tier uses priceCents * this (default 0.93).
HARDIN_PRICE_MULTIPLIER=0.93
# Optional: override allowed 5-digit ZIPs (comma/space-separated). Defaults to Hardin County list in lib/hardin-county.js.
# HARDIN_COUNTY_ZIPS=38372,38326,38361,38365,38370,38375,38379

# --- Staff manual orders (/admin/manual-order): Square payment links + Resend email ---
# Requires PUBLIC_BASE_URL (redirect after Square checkout). Run sql/patch-manual-orders.sql in Supabase
# (manual columns, admin_local_discount_override, updated_at). Optional: sql/patch-admin-local-discount-override.sql if you split patches.
# RESEND_API_KEY + RESEND_FROM must be set for “Send payment link” to email the customer.

# --- Internal reports (GET /api/nexus-summary, GET /api/tax-summary, GET /api/admin-discount-codes) ---
# Production/Vercel: require either Authorization: Bearer <INTERNAL_REPORTS_SECRET> (scripts/cron)
# or Authorization: Bearer <Supabase access JWT> after staff sign-in on /admin/*.
# Staff browsers authenticate with Supabase JWT; they do not need the internal secret.
# Set INTERNAL_REPORTS_SECRET in production for server-to-server callers.
INTERNAL_REPORTS_SECRET=
# INSECURE local-only escape hatch (ignored when NODE_ENV=production or VERCEL=1):
# ALLOW_INSECURE_LOCAL_ADMIN_API=true

# Shopper checkout (/api/checkout-estimate, /api/checkout-pay) requires SHIPPO_API_TOKEN when ADDRESS_VALIDATION
# is on (default). Set ADDRESS_VALIDATION=off for local dev without Shippo; admin estimates pass strictShippo:false
# and still skip remote validation when the token is missing.
ADDRESS_VALIDATION=

# --- Legacy: Square Payment Link (hosted checkout.square.site) ---
# Used only when SQUARE_APPLICATION_ID is NOT set but other Square + Supabase vars are.
#   SQUARE_CHECKOUT_SHIPPING_CENTS=1299

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key (safe in browser). Used by /admin/orders — access is limited by RLS to signed-in users.
# Create staff users in Supabase → Authentication → Users. Set Site URL + Redirect URLs to include /admin/orders.html
SUPABASE_ANON_KEY=

# --- Order confirmation email (Resend) — https://resend.com
# After successful on-site checkout, sends HTML confirmation. Verified sending domain required.
RESEND_API_KEY=
# Must be email@domain.com OR Display Name <email@domain.com> (domain verified in Resend / DNS e.g. Bluehost).
# Examples: RESEND_FROM=sales@saigoods.com
#           RESEND_FROM=SAI Goods <sales@saigoods.com>
RESEND_FROM=

# Optional: squareVariationIds in data/store.json for catalog-linked Square lines.
