# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- On-site checkout (Square Web Payments SDK) — default when this is set ---
# Square Developer → Applications → your app → Credentials → Application ID (sandbox vs production
# must match SQUARE_ENVIRONMENT / access token).
# With Application ID + the vars below, cart "Proceed to checkout" opens /checkout.html: customer
# enters address once; server computes shipping (ZIP) + tax (state); card is charged via Payments API.
SQUARE_APPLICATION_ID=

# US sales tax by destination state. JSON map of 2-letter state → basis points (975 = 9.75%).
# Example: CHECKOUT_STATE_TAX_BPS={"TN":975,"NY":880}
# Confirm rates with your tax adviser. States omitted here = 0% tax on checkout.
CHECKOUT_STATE_TAX_BPS=

# true = tax applies to merchandise + shipping; false = merchandise only
CHECKOUT_TAX_INCLUDES_SHIPPING=true

# --- Legacy: Square Payment Link (hosted checkout.square.site) ---
# Used only when SQUARE_APPLICATION_ID is NOT set but other Square + Supabase vars are.
# Flat shipping on that hosted page (not used by /checkout.html):
#   SQUARE_CHECKOUT_SHIPPING_CENTS=1299
#   SQUARE_CHECKOUT_SHIPPING_USD=12.99
#   SQUARE_CHECKOUT_SHIPPING_LABEL=Shipping
#
# --- Sales tax on Payment Links only (not used by /checkout.html) ---
# Option A: SQUARE_CHECKOUT_AUTO_APPLY_TAXES=true  (catalog taxes; see Square docs)
# Option B: SQUARE_CHECKOUT_TAX_PERCENT=9.75 and optional SQUARE_CHECKOUT_TAX_NAME=...
# Do not combine auto + flat percent.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: squareVariationIds in data/store.json for catalog-linked Square lines.
