# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Checkout sends a Square Order (merchandise line items only). Buyers enter contact + shipping on Square;
# configure shipping rates in the Square Dashboard (this app does not send shipping_fee on the link).
# Optional: squareVariationIds in data/store.json for catalog-linked Square lines.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
