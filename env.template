# Copy to .env and fill in. Never commit .env.
# Vercel: set the same keys under Project → Settings → Environment Variables (Production).

PORT=3000
PUBLIC_BASE_URL=https://store.saigoods.com

SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Checkout uses a Square Order (one line per product × size). For Square to apply per-item shipping from
# catalog weight, create an Item Variation per size in Square Catalog, set shipping weight on each variation,
# then map them in data/store.json on each product:
#   "squareVariationIds": { "Small": "VARIATION_ID", "Medium": "...", ... }
# (IDs from Square Dashboard → Items → variation, or Catalog API.) Leave empty to use ad hoc lines (itemized
# prices from this site; Square shipping rules that need catalog weight won’t see a catalog link).
# Also configure location shipping in the Seller Dashboard.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
