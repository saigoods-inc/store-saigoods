# Copy `env.template` to `.env` for the full variable set. Checkout + Shippo additions:
SHIPPO_API_TOKEN=
SHIPPO_API_BASE_URL=https://api.goshippo.com
SHIPPO_WEBHOOK_TOKEN=
SHIPPO_FROM_NAME=
SHIPPO_FROM_STREET1=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_DEFAULT_ITEM_WEIGHT_LB=1
CHECKOUT_RESIDENTIAL_SURCHARGE_USD=6.50
ADDRESS_VALIDATION=

# UPS live rating (server-side only)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_API_BASE_URL=https://wwwcie.ups.com
UPS_AUTH_TIMEOUT_MS=15000
UPS_RATE_TIMEOUT_MS=20000
UPS_ACCOUNT_NUMBER=
UPS_SHIPPER_NAME=
UPS_SHIP_FROM_STREET1=
UPS_SHIP_FROM_CITY=
UPS_SHIP_FROM_STATE=
UPS_SHIP_FROM_POSTAL_CODE=
UPS_SHIP_FROM_COUNTRY_CODE=US
