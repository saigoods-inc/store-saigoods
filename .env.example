# Copy `env.template` to `.env` for the full variable set. Checkout + Shippo additions:
# Google Analytics 4 web data stream. Leave blank to disable analytics.
GA4_MEASUREMENT_ID=
#
# Admin UI (/admin/*) — required for staff login; served to the browser as JSON from GET /api/supabase-public-config
# You need BOTH: SUPABASE_URL, SUPABASE_ANON_KEY (public “anon” from Dashboard → API). Do not use the service role as the anon key.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SHIPPO_API_TOKEN=
# true (default if unset): force Shippo address_to.is_residential for rating/labels. false: Shippo may auto-detect.
# SHIPPO_ADDRESS_TO_IS_RESIDENTIAL=true
SHIPPO_API_BASE_URL=https://api.goshippo.com
SHIPPO_WEBHOOK_TOKEN=
SHIPPO_FROM_NAME=
SHIPPO_FROM_STREET1=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_DEFAULT_ITEM_WEIGHT_LB=1
CHECKOUT_RESIDENTIAL_SURCHARGE_USD=6.50
ADDRESS_VALIDATION=

# Order confirmation email (Resend) — see env.template for full Resend setup.
# RESEND_API_KEY=
# RESEND_FROM=
# Internal recipient for new paid-order notifications (vendor/ops inbox).
# VENDOR_NOTIFICATION_EMAIL=

# Checkout live rates use Shippo or direct UPS. SHIPPING_RATE_PROVIDER wins; legacy SHIPPING_PROVIDER
# is also accepted. If neither is set, runtime prefers Shippo when SHIPPO_API_TOKEN is set, otherwise UPS.
# SHIPPING_QUOTE_MODE defaults to live_ups (set SHIPPING_QUOTE_MODE=baked_in only for legacy catalog-included shipping).
SHIPPING_RATE_PROVIDER=shippo
SHIPPO_RATE_TIMEOUT_MS=20000
# Cents added to live Shippo/UPS line (e.g. 200 = $2). Set 0 to disable.
SHIPPING_BUFFER_CENTS=200

# UPS live rating (server-side only) — used when SHIPPING_RATE_PROVIDER=ups
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_API_BASE_URL=https://wwwcie.ups.com
UPS_AUTH_TIMEOUT_MS=15000
UPS_RATE_TIMEOUT_MS=20000
UPS_ACCOUNT_NUMBER=
UPS_SHIPPER_NAME=
UPS_SHIP_FROM_STREET1=
UPS_SHIP_FROM_CITY=
UPS_SHIP_FROM_STATE=
UPS_SHIP_FROM_POSTAL_CODE=
UPS_SHIP_FROM_COUNTRY_CODE=US
