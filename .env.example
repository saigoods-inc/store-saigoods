PORT=3000
# Production: https://your-domain.com (no trailing slash). Must match Square webhook URL host.
PUBLIC_BASE_URL=http://localhost:3000

# Square — use sandbox while testing: SQUARE_ENVIRONMENT=sandbox + sandbox credentials from Square Developer Dashboard
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Supabase (for orders persistence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=
VENDOR_NOTIFICATION_EMAIL=
